.{
    .name = .corona_c,
    .version = "0.1.0",
    .fingerprint = 0x604458352d240e43,
    .minimum_zig_version = "0.17.0",

    .dependencies = .{
        // real use: crnreport formats strings with it
        .zigstr = .{ .path = "zig/vendor/zig-string" },
        // compile-only: `zig build bdwgc-zig`; nothing imports or links it
        .bdwgc_zig = .{ .path = "zig/vendor/bdwgc-zig" },
    },

    .paths = .{
        "", // whole package tree: build.zig needs ../src and ../3rdparty
        "build.zig",
        "build.zig.zon",
        "zig",
    },
}
